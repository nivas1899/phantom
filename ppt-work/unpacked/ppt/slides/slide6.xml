="34" charset="0"/><a:buChar char="•"/></a:pPr><a:r><a:rPr lang="en-IN" sz="2400" b="0" dirty="0"/><a:t>Identify open ports and running network services.</a:t></a:r></a:p><a:p><a:pPr marL="342900" lvl="0" indent="-342900"><a:buFont typeface="Arial" panose="020B0604020202020204" pitchFamily="34" charset="0"/><a:buChar char="•"/></a:pPr><a:r><a:rPr lang="en-IN" sz="2400" b="0" dirty="0"/><a:t>Analyse exposed services using configurable security rules.</a:t></a:r></a:p><a:p><a:pPr marL="342900" lvl="0" indent="-342900"><a:buFont typeface="Arial" panose="020B0604020202020204" pitchFamily="34" charset="0"/><a:buChar char="•"/></a:pPr><a:r><a:rPr lang="en-IN" sz="2400" b="0" dirty="0"/><a:t>Identify potential network exposure risks and provide recommendations.</a:t></a:r></a:p><a:p><a:pPr marL="342900" lvl="0" indent="-342900"><a:buFont typeface="Arial" panose="020B0604020202020204" pitchFamily="34" charset="0"/><a:buChar char="•"/></a:pPr><a:r><a:rPr lang="en-IN" sz="2400" b="0" dirty="0"/><a:t>Maintain scan history and generate downloadable HTML reports.</a:t></a:r></a:p></p:txBody></p:sp></p:spTree></p:cSld><p:clrMapOvr><a:masterClrMapping/></p:clrMapOvr></p:sld>